# Self-Hosted VPS PostgreSQL 16 (Internal Coolify Docker Network)
DATABASE_URL="postgresql://rk444_user:REPLACE_WITH_STRONG_PASSWORD@rk444-postgres:5432/rk444?schema=public&connection_limit=15&pool_timeout=20&connect_timeout=10"
DIRECT_URL="postgresql://rk444_user:REPLACE_WITH_STRONG_PASSWORD@rk444-postgres:5432/rk444?schema=public"

# Optional Prisma Pool Tuning (defaults: limit=15, pool_timeout=20, connect_timeout=10)
PRISMA_CONNECTION_LIMIT="15"
PRISMA_POOL_TIMEOUT="20"
PRISMA_CONNECT_TIMEOUT="10"

# Set to "true" on first deploy only if you want initial seed data
RUN_DB_SEED="false"

# Application & Auth Secrets
ENVIRONMENT="production"
NEXT_PUBLIC_SITE_URL="https://rk444.site"
NEXT_PUBLIC_SERVER_URL="https://rk444.site"
NEXT_PUBLIC_APP_URL="https://rk444.site"
AUTH_SECRET=""
JWT_SECRET=""
ADMIN_SECRET=""

# SoftAPI Configuration
SOFTAPI_TOKEN=""
SOFTAPI_SECRET=""
SOFTAPI_SERVER_URL="https://world-casino-api.com/api/v1"
SOFTAPI_RETURN_URL="https://rk444.site/games"
SOFTAPI_CALLBACK_URL="https://rk444.site/api/softapi/callback"
